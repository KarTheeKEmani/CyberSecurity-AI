# AIAC Cyber — Environment Configuration Example
PROJECT_NAME="AIAC Cyber — Incident Response Platform"
VERSION=2.5.0
ENVIRONMENT=development
DEMO_MODE=true

# Database (PostgreSQL for Production / Docker; SQLite for lightweight local dev)
DATABASE_URL=sqlite:///./aiac_cyber.db
# DATABASE_URL=postgresql://aiac_user:aiac_secure_password_2026@localhost:5432/aiac_cyber

# JWT Security
JWT_SECRET_KEY=generate-a-secure-random-secret-key-for-production-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000","http://localhost:5173"]

# AI Configuration
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Email Notifications (SMTP)
EMAIL_ENABLED=false
EMAIL_DEMO_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=security@cybersentinel.ai
EMAIL_FROM_NAME=CyberSentinel AI

# Alert Generator
MOCK_GENERATOR_ENABLED=false
MOCK_GENERATOR_INTERVAL_SECONDS=60


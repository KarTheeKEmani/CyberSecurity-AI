# CyberSentinel AI — Environment Configuration
# ============================================================

# Application
ENVIRONMENT=development
DEMO_MODE=true
VERSION=3.0.0

# Database
DATABASE_URL=sqlite:///./aiac_cyber.db

# JWT Security
JWT_SECRET_KEY=super-secret-jwt-key-for-aiac-cyber-soc-2026-change-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080","null"]

# AI Provider
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# =============================================================
# Email / SMTP Configuration
# Set EMAIL_ENABLED=true and fill SMTP credentials to send real emails.
# While SMTP credentials are not configured, the system runs in demo
# mode: emails are simulated and logged but not delivered.
# =============================================================
EMAIL_ENABLED=false
EMAIL_DEMO_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=security@cybersentinel.ai
EMAIL_FROM_NAME=CyberSentinel AI

# Alert Notification Recipients (comma-separated)
NOTIFICATION_RECIPIENTS=["2503A52483@sru.edu.in","2503A52499@sru.edu.in"]

# =============================================================
# Automated Alert Generator Scheduler
# AUTO_ALERT_ENABLED=true → generates one random alert every
# AUTO_ALERT_INTERVAL_SECONDS seconds and sends email to
# NOTIFICATION_RECIPIENTS.
# =============================================================
AUTO_ALERT_ENABLED=true
AUTO_ALERT_INTERVAL_SECONDS=50
MOCK_GENERATOR_ENABLED=true
MOCK_GENERATOR_INTERVAL_SECONDS=50
MOCK_GENERATOR_MAX_PER_HOUR=72
